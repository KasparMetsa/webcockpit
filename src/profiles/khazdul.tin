#ACTION {WARNING}
{
    sc
}

#ACTION {^%1 raises her hand.$}
{
    group %1
}

#ACTION {^%1 raises his hand.$}
{
    group %1
}

#ACTION {^%1key: '%2'$}
{
    #showme %0
}

#ACTION {^You are already wearing an ebony tunic on your body.$}
{
    #variable {body} {tunic}
}

#ACTION {^You wear a coarse dusky robe on your body.$}
{
    #variable {body} {robe}
}

#ACTION {^You wear a fine metal breastplate on your body.$}
{
    #variable {body} {plate}
}

#ACTION {^You wear a frayed tunic on your body.$}
{
    #variable {body} {tunic}
}

#ACTION {^You wear a grey tunic on your body.$}
{
    #variable {body} {tunic}
}

#ACTION {^You wear a shining breastplate on your body.$}
{
    #variable {body} {plate}
}

#ACTION {^You wear a shining chain mail shirt on your body.$}
{
    #variable {body} {shirt}
}

#ACTION {^You wear an ebony tunic on your body.$}
{
    #variable {body} {tunic}
}

#ALIAS {2}
{
    _send close $sd2
}

#ALIAS {3}
{
    _send open $sd2
}

#ALIAS {^b%+1..d$}
{
    _send cast $ss 'blindness' %1.$target
}

#ALIAS {_eq_body}
{
    #if {"%1" != "$abody"}
    {
        #if {"$abody" != ""}
        {
            _send rem $abody
        };
        _send get %1 pack;
        _send wear %1;
        #if {"$abody" != ""}
        {
            _send put $abody pack
        };
        #variable {abody} {%1}
    }
}

#ALIAS {_eq_ring}
{
    #if {"%1" != "$ring"}
    {
        #if {"$ring" != ""}
        {
            _send rem $ring
        };
        _send get %1 sable;
        _send wear %1;
        #if {"$ring" != ""}
        {
            _send put $ring sable
        };
        #variable {ring} {%1}
    }
}

#ALIAS {_show_acontainer}
{
    #showme {<F9AA8B7>## ARROW CONTAINER: <FFFFFFF>$acontainer  <F9AA8B7>(ammo: <FFFFFFF>$arrow<F9AA8B7>)<099>}
}

#ALIAS {_show_class}
{
    #showme {<F9AA8B7>## CLASS: <FFFFFFF>$class<099>}
}

#ALIAS {_show_spell}
{
    #if {"$spell" != ""}
    {
        #showme {<F9AA8B7>## SPELL: <FFFFFFF>$spell<099>}
    };
    #else
    {
        #showme {<F9AA8B7>## SPELL: <099>(none)}
    }
}

#ALIAS {_show_spell_speed}
{
    #showme {<F9AA8B7>## SPELL-SPEED: <FFFFFFF>$ss<099>}
}

#ALIAS {a1}
{
    push forostar north;
    push orrostar east;
    push hyarrostar southeast;
    push hyarnustar southwest;
    push andustar west;
    push mittalmar center
}

