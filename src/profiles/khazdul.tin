#HIGHLIGHT {- shadow-link} {Green} {5}
#HIGHLIGHT {- shield} {Cyan} {5}
#HIGHLIGHT {- shroud} {Cyan} {5}
#HIGHLIGHT {- spectral health} {Green} {5}
#HIGHLIGHT {- stored spell %1} {magenta} {5}
#HIGHLIGHT {- strength} {Cyan} {5}
#HIGHLIGHT {- tiredness} {red} {5}
#HIGHLIGHT {- very comfortable} {green} {5}
#HIGHLIGHT {A pair of tiny eyes gleam at you from the shadows.} {Cyan} {5}
#HIGHLIGHT {AA} {green} {5}
#HIGHLIGHT {BB} {green} {5}
#HIGHLIGHT {CC} {green} {5}
#HIGHLIGHT {DD} {green} {5}
#HIGHLIGHT {MIN} {cyan} {5}
#MACRO {\eOP}
{
    _send hit $target
}

#MACRO {\eOQ}
{
    #if {"$class" == "warrior"}
    {
        _send bash $target
    };
    #elseif {"$class" == "caster" || "$class" == "warcaster"}
    {
        _send cast $ss $spell $target
    };
    #elseif {"$class" == "thief"}
    {
        _send backstab $target
    }
}

#MACRO {\eOR}
{
    #if {"$class" == "warrior"}
    {
        _send bash
    };
    #elseif {"$class" == "caster" || "$class" == "warcaster"}
    {
        _send cast $ss $spell
    };
    #elseif {"$class" == "thief"}
    {
        _send shoot
    }
}

#MACRO {\eOS}
{
    #if {"$class" == "warrior" || "$class" == "warcaster"}
    {
        _send kick
    };
    #elseif {"$class" == "caster" || "$class" == "thief"}
    {
        _send shoot $target
    }
}

#MACRO {\e[15~}
{
    _send draw $weap1
}

#MACRO {\e[17~}
{
    _send draw $weap2
}

#MACRO {\e[18~}
{
    _send draw $weap3
}

#MACRO {\e[19~}
{
    _send sc
}

#MACRO {\e[20~}
{
    _send sc
}

#SUBSTITUTE {^%1 seems to be blinded!} {<F23aaee>%0<900>} {5}
#SUBSTITUTE {^-%1wound%2} {<Fff0000>%0<900>} {5}
#TICKER {clock} {#lua {state.world.clock.tick()}} {0.25}
#VARIABLE {_sd_line} {<F9AA8B7> SD1: <FFFFFFF>exit<F9AA8B7>  SD2: <FFFFFFF>way}
#VARIABLE {abody} {mantle}
#VARIABLE {acontainer} {quiver}
#VARIABLE {arrow} {arrow}
#VARIABLE {body} {tunic}
#VARIABLE {character} {Rasta}
#VARIABLE {class} {caster}
#VARIABLE {ring} {copperring}
#VARIABLE {sd1} {exit}
#VARIABLE {sd2} {way}
#VARIABLE {sd3} {}
#VARIABLE {spell} {'hold'}
#VARIABLE {ss} {normal}
#VARIABLE {target} {*elf*}
#VARIABLE {test} {look}
#VARIABLE {weap1} {hewer }
#VARIABLE {weap2} {engraved}
#VARIABLE {weap3} {engraved}
#VARIABLE {weapon1} {bow}

